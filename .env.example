# HugeGraph SERVER address, not the Hubble web interface (usually port 8088).
# Use the host port published for the HugeGraph Server container.
HUGEGRAPH_URL=http://127.0.0.1:8080
# auto detects scoped APIs, falling back to legacy APIs on unsupported paths.
# Set legacy for 1.5 or graphspace for 1.7+ if your gateway requires it.
HUGEGRAPH_API_MODE=auto
HUGEGRAPH_GRAPHSPACE=DEFAULT
HUGEGRAPH_USERNAME=
HUGEGRAPH_PASSWORD=
# Optional bearer token takes precedence over Basic authentication.
HUGEGRAPH_TOKEN=
# Creation uses an existing RocksDB or memory graph as a storage template.
# Your HugeGraph version and server account must permit dynamic graph creation.
HUGEGRAPH_ALLOW_CREATE=true
HUGEGRAPH_TIMEOUT_MS=15000
HUGEGRAPH_MAX_ELEMENTS=10000
HUGEGRAPH_MAX_SCAN=100000
PORT=3001
HOST=127.0.0.1
